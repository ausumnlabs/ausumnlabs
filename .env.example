# Public site address (used for canonical links, sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://ausumnlabs.in

# Bitrix24 inbound webhook with CRM access, ending in a slash.
# Example: https://ausumnlabs.bitrix24.in/rest/1/abc123xyz/
# Set it on Fly with: fly secrets set BITRIX24_WEBHOOK_URL=...
BITRIX24_WEBHOOK_URL=

# Optional: Bitrix24 user ID to assign website leads to
BITRIX24_ASSIGNED_BY_ID=

# Optional: Cloudflare Turnstile spam protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: Google Analytics 4 measurement ID, e.g. G-XXXXXXX
NEXT_PUBLIC_GA_ID=

# Optional: Google Search Console verification code
NEXT_PUBLIC_GSC_VERIFICATION=
